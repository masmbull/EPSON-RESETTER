<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0B6BCB" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#08519C" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E8F1FB" />

    <!-- Surface -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#162431" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#203447" />
    <SolidColorBrush x:Key="Brush.SidebarActive" Color="#2A455E" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#B8C6D4" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#7A8FA3" />
    <SolidColorBrush x:Key="Brush.SidebarAccent" Color="#0B6BCB" />

    <SolidColorBrush x:Key="Brush.PageBackground" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D5DDE5" />
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#FAFBFD" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#F7F9FC" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#16212E" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5B6B7C" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8593A3" />
    <SolidColorBrush x:Key="Brush.OnDark" Color="#FFFFFF" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Success" Color="#15803D" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E7F6EC" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FDF3E3" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FCE9E9" />
    <SolidColorBrush x:Key="Brush.Info" Color="#0B6BCB" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#EEF4FB" />

</ResourceDictionary>
