<Window x:Class="EpsonResetter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EPSON RESETTER"
        Height="880" Width="1320" MinHeight="660" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.PageBackground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RescanCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
            <Grid Margin="18,22,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="9"
                                Background="{StaticResource Brush.SidebarAccent}"
                                VerticalAlignment="Center">
                            <Path Width="19"
                                  Height="19"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Data="{StaticResource Icon.Box}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EPSON" FontSize="17" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="R E S E T T E R"
                                       FontSize="8.5"
                                       Foreground="{StaticResource Brush.SidebarMuted}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#1F3850" Margin="0,18,0,14" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Navigation"
                                         Style="{StaticResource Nav.Radio}"
                                         Tag="{Binding IconKey}"
                                         Content="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                         CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="LOCAL WORKSPACE"
                               FontSize="9.5"
                               Foreground="{StaticResource Brush.SidebarMuted}" />
                    <TextBlock Text="Windows print subsystem"
                               FontSize="11"
                               Foreground="{StaticResource Brush.SidebarText}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="EPSON RESETTER"
                                   FontSize="9.5"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding RescanCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Brush.Accent}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="{StaticResource Icon.Refresh}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Rescan printers" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageTransform" />
                </ContentControl.RenderTransform>
            </ContentControl>

            <Border Grid.Row="2" Background="{StaticResource Brush.Sidebar}">
                <Grid Margin="26,0">
                    <Border x:Name="ProgressTrack"
                            Height="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Opacity="0"
                            Visibility="{Binding State.IsScanning, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="ProgressSlide" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Offset="0" Color="#0E2C4D" />
                                <GradientStop Offset="0.5" Color="#4C9AFF" />
                                <GradientStop Offset="1" Color="#0E2C4D" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="{Binding State.StatusMessage}"
                               Foreground="#8FA9C2"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Working..."
                               Foreground="#4C9AFF"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Visibility="{Binding State.IsScanning, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>