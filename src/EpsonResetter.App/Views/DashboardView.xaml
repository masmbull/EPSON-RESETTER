<UserControl x:Class="EpsonResetter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="What Windows reports about the local printers and what EPSON RESETTER has recorded."
                           Style="{StaticResource Text.PageSubtitle}" />
            </StackPanel>

            <Button Style="{StaticResource Button.Secondary}"
                    Content="Rescan printers"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="PRINTERS" Style="{StaticResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding TotalPrinters}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="EPSON" Style="{StaticResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding EpsonPrinters}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Identified from the printer and driver name"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="NETWORK" Style="{StaticResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding NetworkPrinters}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Printers on a TCP/IP port"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="OFFLINE OR ERROR" Style="{StaticResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding OfflinePrinters}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Danger}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Reported by the print spooler"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="The last recorded actions from this computer."
                                       Style="{StaticResource Text.Hint}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Ghost}"
                                Content="View all"
                                Command="{Binding OpenHistoryCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivity}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimestampDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PrinterName}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Result}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1"
                               Text="No activity has been recorded yet."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActivity}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{Binding SpoolerText}" Style="{StaticResource Text.Value}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding CompatibilityText}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ResetSupportText}"
                               Style="{StaticResource Text.Value}"
                               Foreground="{StaticResource Brush.Warning}"
                               Margin="0,8,0,0" />

                    <Border Height="1"
                            Background="{StaticResource Brush.Border}"
                            Margin="0,16,0,16" />

                    <TextBlock Text="EPSON RESETTER reads the Windows print subsystem only. It does not install drivers, modify the spooler or send reset commands to printers."
                               Style="{StaticResource Text.Hint}" />

                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Open printer list"
                            Command="{Binding OpenPrintersCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />

                    <Button Style="{StaticResource Button.Ghost}"
                            Content="Open settings"
                            Command="{Binding OpenSettingsCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>