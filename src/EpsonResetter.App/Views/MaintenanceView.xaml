<UserControl x:Class="EpsonResetter.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Style="{StaticResource Section.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Section.Icon}">
                <Path Style="{StaticResource Section.Glyph}" Data="{StaticResource Icon.Tools}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Maintenance" Style="{StaticResource Section.Title}" />
                <TextBlock Text="Standard Windows print-system actions for the selected printer."
                           Style="{StaticResource Section.Subtitle}" />
            </StackPanel>

            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Printer, Converter={StaticResource InverseBoolToVis}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Printer.Name, TargetNullValue=No printer selected}"
                           FontSize="11.5"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- ACTION CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card.Section}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Open print queue" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="Shows the Windows print queue for this printer, including pending documents and the pause state."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Open queue"
                            Command="{Binding OpenQueueCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card.Section}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Printer properties" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="Opens the Windows printer properties dialog with the driver, port, sharing and advanced settings."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Open properties"
                            Command="{Binding OpenPropertiesCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card.Section}" Margin="0,16,8,0">
                <StackPanel>
                    <TextBlock Text="Print a test page" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="Sends the standard Windows test page to this printer. Use it to confirm the physical print path."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Print test page"
                            Command="{Binding PrintTestPageCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card.Section}" Margin="8,16,0,0">
                <StackPanel>
                    <TextBlock Text="Open Web Admin" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="Opens the printer's built-in administration page in the default browser using the detected address."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Open Web Admin"
                            Command="{Binding OpenWebAdminCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- MESSAGE -->
        <Border Grid.Row="2"
                Padding="14"
                CornerRadius="8"
                Margin="0,0,0,16"
                VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.InfoSoft}" />
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- FOOTER -->
        <TextBlock Grid.Row="3"
                   Text="These actions use the built-in Windows print dialogs. No vendor service utility, reset command or undocumented printer command is invoked."
                   Style="{StaticResource Text.Hint}"
                   Margin="0,0,0,0" />
    </Grid>
</UserControl>
