<UserControl x:Class="EpsonResetter.App.Views.WasteInkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Style="{StaticResource Section.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Section.Icon}">
                <Path Style="{StaticResource Section.Glyph}" Data="{StaticResource Icon.Droplet}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Waste Ink Counter" Style="{StaticResource Section.Title}" />
                <TextBlock Text="Model-aware counter information and reset eligibility checks. Values are shown only when a verified, permitted method exists."
                           Style="{StaticResource Section.Subtitle}" />
            </StackPanel>

            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Printer, Converter={StaticResource InverseBoolToVis}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Printer.Name, TargetNullValue=No printer selected}"
                           FontSize="11.5"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- SUPPORT STATUS -->
        <Border Grid.Row="1"
                Style="{StaticResource Card.Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Support level" Style="{StaticResource Card.HeaderLabel}" />
                    <Border Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportLevel}" Value="Supported">
                                        <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SupportLevel}" Value="Unsupported">
                                        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SupportLevel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Model" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="{Binding ModelText, TargetNullValue=Not selected}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding KnownModelText, StringFormat=Registered: {0}}"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding SupportMessage}"
                           Style="{StaticResource Text.Value}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- COUNTER READING -->
            <Border Grid.Column="0" Style="{StaticResource Card.Section}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Counter reading" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="{Binding CounterText}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding CounterMessage}"
                               Style="{StaticResource Text.Hint}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Read counter"
                            Command="{Binding ReadCounterCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- RESET ELIGIBILITY -->
            <Border Grid.Column="1" Style="{StaticResource Card.Section}">
                <StackPanel>
                    <TextBlock Text="Reset eligibility" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="A reset is only eligible when the model is registered, a vendor-authorised method is verified, the printer is reachable, and the waste ink system has been serviced."
                               Style="{StaticResource Text.Hint}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,14" />

                    <CheckBox Content="Waste ink pad or collection system inspected and serviced"
                              IsChecked="{Binding PadInspected}"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Equipment owner has authorised the reset"
                              IsChecked="{Binding OwnerAuthorised}"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Operator has confirmed the documented procedure for this exact model"
                              IsChecked="{Binding MethodConfirmed}"
                              Margin="0,0,0,14" />

                    <Button Style="{StaticResource Button.Primary}"
                            Content="Check reset eligibility"
                            Command="{Binding EvaluateEligibilityCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14" />

                    <Border Padding="12" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEligible}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasEvaluated}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding EligibilitySummary}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EligibilityCode}"
                                       Style="{StaticResource Text.Mono}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding EligibilityReasons}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{StaticResource Brush.Warning}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SAFETY NOTICE -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="14"
                CornerRadius="8"
                VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="No reset is performed by this build."
                           FontSize="12.5"
                           FontWeight="SemiBold" />
                <TextBlock Text="EPSON RESETTER does not contain a reset executor, service utility, activation key or undocumented printer command. This page reports eligibility only. Unsupported models stay disabled."
                           Style="{StaticResource Text.Hint}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
