<UserControl x:Class="EpsonResetter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Style="{StaticResource Section.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Section.Icon}">
                <Path Style="{StaticResource Section.Glyph}" Data="{StaticResource Icon.Settings}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Settings" Style="{StaticResource Section.Title}" />
                <TextBlock Text="Web Admin defaults, network timeouts and local storage. Settings are stored in the local SQLite database."
                           Style="{StaticResource Section.Subtitle}" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- WEB ADMIN AND NETWORK -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card.Section}"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Web Admin and network" Style="{StaticResource Card.HeaderLabel}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Preferred scheme" Grid.Row="0" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding SchemeOptions}"
                                  SelectedItem="{Binding PreferredScheme}"
                                  HorizontalAlignment="Left"
                                  Width="240"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="HTTP port" Grid.Row="1" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="HTTPS port" Grid.Row="2" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding HttpsPort, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="Network timeout (ms)" Grid.Row="3" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding NetworkTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 HorizontalAlignment="Left" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,16" />

                    <TextBlock Text="Defaults" Style="{StaticResource Card.HeaderLabel}" Margin="0,0,0,8" />

                    <CheckBox Content="Show only Epson printers by default"
                              IsChecked="{Binding ShowOnlyEpson}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Ask before opening a printer Web Admin page"
                              IsChecked="{Binding ConfirmBeforeOpening}"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Printer administrator credentials are never stored. URLs containing credentials are rejected."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource Brush.Danger}"
                                           FontSize="12.5"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Save settings"
                                Command="{Binding SaveCommand}" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Restore defaults"
                                Command="{Binding ResetDefaultsCommand}"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding Message, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            <!-- LOCAL STORAGE -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card.Section}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Local storage" Style="{StaticResource Card.HeaderLabel}" Margin="0,0,0,14" />

                    <TextBlock Text="Database" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DatabasePathText}" Style="{StaticResource Text.Mono}" Margin="0,0,0,16" />

                    <TextBlock Text="Logs" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LogPathText}" Style="{StaticResource Text.Mono}" Margin="0,0,0,20" />

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,16" />

                    <TextBlock Text="Compatibility registry" Style="{StaticResource Card.HeaderLabel}" Margin="0,0,0,8" />

                    <TextBlock Text="Entries are only marked as supported when a documented, vendor-authorised method has been verified for the exact model. No reset method is currently enabled."
                               Style="{StaticResource Text.Hint}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ERROR -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource Brush.Danger}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
    </Grid>
</UserControl>
