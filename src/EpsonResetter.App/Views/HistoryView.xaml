<UserControl x:Class="EpsonResetter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Header.Badge}" Margin="0,0,12,0">
                    <Path Style="{StaticResource Header.Glyph}" Data="{StaticResource Icon.History}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Activity History" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="Every meaningful action recorded locally, including diagnostics, Web Admin, maintenance and eligibility checks."
                               Style="{StaticResource Text.PageSubtitle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Reload"
                        Command="{Binding LoadCommand}"
                        Margin="8,0,0,0" />
                <Button Style="{StaticResource Button.Danger}"
                        Content="Clear history"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search printer, action, model or details" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Summary}"
                           Style="{StaticResource Text.Hint}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <DataGrid Style="{StaticResource DataGrid.Default}"
                      ItemsSource="{Binding FilteredRecords}"
                      SelectedItem="{Binding SelectedRecord}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp"
                                        Binding="{Binding TimestampDisplay}"
                                        Width="150"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Printer"
                                        Binding="{Binding PrinterName}"
                                        Width="200" />
                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding ModelName}"
                                        Width="110" />
                    <DataGridTextColumn Header="Action"
                                        Binding="{Binding Action}"
                                        Width="190" />
                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Result}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result}" Value="Failure">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result}" Value="Unavailable">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result}" Value="Skipped">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Details"
                                        Binding="{Binding Details}"
                                        Width="*" />
                    <DataGridTextColumn Header="Error"
                                        Binding="{Binding Error}"
                                        Width="200" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecords}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="No activity has been recorded yet."
                           Style="{StaticResource Text.Hint}"
                           TextAlignment="Center" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource Brush.Danger}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
    </Grid>
</UserControl>