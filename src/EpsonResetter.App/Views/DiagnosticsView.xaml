<UserControl x:Class="EpsonResetter.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Style="{StaticResource Section.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Section.Icon}">
                <Path Style="{StaticResource Section.Glyph}" Data="{StaticResource Icon.Pulse}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Diagnostics" Style="{StaticResource Section.Title}" />
                <TextBlock Text="Read-only checks of the Windows print path and, for network printers, the printer itself."
                           Style="{StaticResource Section.Subtitle}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Primary}"
                    Content="Run diagnostics"
                    Command="{Binding RunCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,0,0" />
        </Grid>

        <!-- RESULT SUMMARY CARD -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,16"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Printer" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="{Binding Printer.Name, TargetNullValue=No printer selected}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ModelText}"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Result" Style="{StaticResource Card.HeaderLabel}" />
                    <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Completed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                </Border>
            </Grid>
        </Border>

        <!-- EMPTY STATE (before running) -->
        <Border Grid.Row="2"
                Style="{StaticResource Empty.State}"
                Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="No diagnostic results yet"
                           Style="{StaticResource Empty.StateTitle}" />
                <TextBlock Text="Run a diagnostic pass to check the print spooler, driver, port, ICMP connectivity, TCP 9100 and Web Admin availability."
                           Style="{StaticResource Empty.StateHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="Run diagnostics"
                        Command="{Binding RunCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- RESULTS -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,0"
                      Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Report.Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="●" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource Text.Mono}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        <!-- ERROR -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource Brush.Danger}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <!-- NO PRINTER STATE -->
        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Padding="28"
                Visibility="{Binding HasPrinter, Converter={StaticResource InverseBoolToVis}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPrinter}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="No printer selected"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Choose a printer in the printer list, then return to diagnostics."
                           Style="{StaticResource Text.Hint}"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
